"passages": [
{
"id": "R-A1-01",
"skill": "reading",
"title": "أَنا سَلْمى",
"body": "اِسْمي سَلْمى. أَنا مِنَ المَغْرِب، وَأَسْكُنُ الآنَ في المَدينَةِ المُنَوَّرَة. أَنا طالِبَةٌ في جامِعَةِ أَثَر. أَدْرُسُ اللُّغَةَ العَرَبِيَّةَ في الصَّباح، وَأَعْمَلُ في المَكْتَبَةِ بَعْدَ الظُّهْر. عِنْدي أَخٌ واحِدٌ اسْمُهُ يوسُف، وَهُوَ طَبيبٌ في المُسْتَشْفى."
},
{
"id": "R-A1-02",
"skill": "reading",
"title": "لافِتَةٌ في المَتْجَر",
"body": "مَتْجَرُ النّور — أَسْعارُ اليَوْم:\nخُبْز: ٢ ريال\nحَليب (لِتْر): ٥ رِيالات\nبَيْض (١٢ بَيْضَة): ١٥ رِيالًا\nتُفّاح (كيلو): ٨ رِيالات\nالمَتْجَرُ مَفْتوحٌ مِنَ السّاعَةِ ٧ صَباحًا إِلى ١١ مَساءً. يَوْمَ الجُمُعَة: مُغْلَقٌ مِنَ ١٢ إِلى ٢ ظُهْرًا."
},
{
"id": "R-A1-03",
"skill": "reading",
"title": "رِسالَةٌ قَصيرَة",
"body": "مَرْحَبًا أَحْمَد،\nأَنا في المَطارِ الآن. الطّائِرَةُ في السّاعَةِ الثّالِثَة. أَصِلُ إِلى جَدَّةَ في السّاعَةِ الخامِسَة. هَلْ تَأْتي إِلى المَطار؟ مَعي حَقيبَةٌ كَبيرَةٌ وَحَقيبَةٌ صَغيرَة. شُكْرًا لَك.\nصَديقُك، عُمَر"
},
{
"id": "R-A1-04",
"skill": "reading",
"title": "جَدْوَلُ الدُّروس",
"body": "جَدْوَلُ الأُسْبوع — الصَّفُّ الأَوَّل:\nالأَحَد: قِراءَة (٩–١٠) · كِتابَة (١٠–١١)\nالاثْنَيْن: اسْتِماع (٩–١٠) · مُحادَثَة (١٠–١١)\nالثُّلاثاء: قَواعِد (٩–١١)\nالأَرْبِعاء: رِحْلَةٌ إِلى المَتْحَف (٨–١٢)\nالخَميس: اخْتِبارٌ قَصير (٩–١٠)\nالمُعَلِّمَة: الأُسْتاذَة هُدى — الغُرْفَة ٢٠٤"
},
{
"id": "R-A1-05",
"skill": "reading",
"title": "في المَطْعَم",
"body": "مَطْعَمُ البَيْت\nقائِمَةُ الطَّعام:\nأَرُزٌّ مَعَ دَجاج — ٢٥ رِيالًا\nسَمَكٌ مَشْوِيّ — ٣٠ رِيالًا\nسَلَطَة — ١٠ رِيالات\nشاي أَوْ قَهْوَة — ٥ رِيالات\nماء — مَجّانًا\nنَفْتَحُ كُلَّ يَوْمٍ مِنَ ١٢ ظُهْرًا إِلى ١٢ لَيْلًا. لا نَفْتَحُ يَوْمَ الجُمُعَةِ صَباحًا."
},
{
"id": "L-A1-01",
"skill": "listening",
"title": "تَعارُف",
"body": "السَّلامُ عَلَيْكُم. اِسْمي خالِد. أَنا مِنْ إِنْدونيسْيا، وَأَسْكُنُ في مَكَّة. أَنا مُهَنْدِس. أَعْمَلُ في شَرِكَةٍ كَبيرَة. في الصَّباحِ أَذْهَبُ إِلى العَمَلِ بِالسَّيّارَة، وَفي المَساءِ أَدْرُسُ العَرَبِيَّةَ في المَعْهَد.",
"speed": "slow"
},
{
"id": "L-A1-02",
"skill": "listening",
"title": "في السّوق",
"body": "— صَباحَ الخَيْر. بِكَمِ الكيلو مِنَ البُرْتُقال؟\n— صَباحَ النّور. الكيلو بِسِتَّةِ رِيالات.\n— أُريدُ كيلوَيْن، مِنْ فَضْلِك.\n— تَفَضَّلي. اِثْنا عَشَرَ رِيالًا.\n— هَلْ عِنْدَكَ مَوْز؟\n— لا، لَيْسَ عِنْدي مَوْزٌ اليَوْم.",
"speed": "slow"
},
{
"id": "L-A1-03",
"skill": "listening",
"title": "مَوْعِدٌ مَعَ الطَّبيب",
"body": "مَرْحَبًا، هٰذِهِ رِسالَةٌ مِنْ عِيادَةِ الدُّكْتورَةِ نورَة. مَوْعِدُكِ يَوْمَ الثُّلاثاء، في السّاعَةِ العاشِرَةِ صَباحًا. العِيادَةُ في الدَّوْرِ الثّاني، الغُرْفَةُ رَقْم خَمْسَة. مِنْ فَضْلِكِ أَحْضِري بِطاقَتَكِ. شُكْرًا.",
"speed": "slow"
},
{
"id": "L-A1-04",
"skill": "listening",
"title": "يَوْمي",
"body": "أَسْتَيْقِظُ في السّاعَةِ السّادِسَة. أُصَلّي، ثُمَّ أَشْرَبُ القَهْوَةَ مَعَ أُمّي. أَذْهَبُ إِلى الجامِعَةِ بِالحافِلَة. بَعْدَ الدُّروسِ أَلْعَبُ كُرَةَ القَدَمِ مَعَ أَصْدِقائي. في اللَّيْلِ أَقْرَأُ كِتابًا، وَأَنامُ في السّاعَةِ الحادِيَةَ عَشْرَة.",
"speed": "slow"
}
],

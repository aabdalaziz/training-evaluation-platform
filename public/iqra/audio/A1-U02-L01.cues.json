{"v":1,"code":"A1-U02-L01","src":"/iqra/audio/A1-U02-L01.mp3","level":"A1","rate":"-20%","dur":211.73,"cast":"athar-voices-1","cues":[{"k":"intro","s":0.0,"e":25.99,"d":"أَوَّلُ يَوْمٍ فِي صَفِّ هِنْدٍ بِمَعْهَدِ اللُّغَةِ. هِنْدٌ تُقَدِّمُ الطُّلَّابَ وَاحِدًا وَاحِدًا، ثُمَّ اثْنَيْنِ اثْنَيْنِ، ثُمَّ الْجَمِيعَ. اسْمَعْ جَيِّدًا نِهَايَةَ كُلِّ كَلِمَةٍ: التَّاءُ الْمَرْبُوطَةُ لِلْمُؤَنَّثِ، وَالْأَلِفُ وَالنُّونُ لِلِاثْنَيْنِ، وَالْوَاوُ وَالنُّونُ وَالْأَلِفُ وَالتَّاءُ لِلْجَمَاعَةِ."},{"k":"line","i":0,"r":"هند","g":"f","a":"teacher","s":25.99,"e":32.52,"d":"صَبَاحُ الْخَيْرِ. أَنَا هِنْدٌ، مُعَلِّمَةُ الْعَرَبِيَّةِ."},{"k":"line","i":1,"r":"هند","g":"f","a":"teacher","s":32.52,"e":41.45,"d":"هَذِهِ مَارْيَا، طَالِبَةٌ مِنْ إِسْبَانْيَا. وَهَذَا يُوسُفُ، طَالِبٌ مِنْ نَيْجِيرْيَا."},{"k":"line","i":2,"r":"هند","g":"f","a":"teacher","s":41.45,"e":50.26,"d":"كِينْ وَأَحْمَدُ طَالِبَانِ مِنَ الْيَابَانِ وَمِصْرَ. وَلَيْلَى وَرِيمُ طَالِبَتَانِ مِنَ الْمَدِينَةِ."},{"k":"line","i":3,"r":"هند","g":"f","a":"teacher","s":50.26,"e":57.67,"d":"نَحْنُ فِي الصَّفِّ اثْنَا عَشَرَ طَالِبًا: سَبْعَةُ طُلَّابٍ وَخَمْسُ طَالِبَاتٍ."},{"k":"line","i":4,"r":"ماريا","g":"f","a":"student","s":57.67,"e":63.17,"d":"وَأَنْتِ يَا هِنْدُ، كَمْ مُعَلِّمًا فِي الْمَعْهَدِ؟"},{"k":"line","i":5,"r":"هند","g":"f","a":"teacher","s":63.17,"e":72.26,"d":"فِي الْمَعْهَدِ سِتَّةُ مُعَلِّمِينَ وَأَرْبَعُ مُعَلِّمَاتٍ. وَالْمُدِيرُ اسْمُهُ الْأُسْتَاذُ حَسَنٌ."},{"k":"line","i":6,"r":"يوسف","g":"m","a":"doctor","s":72.26,"e":74.69,"d":"وَالْكُتُبُ؟"},{"k":"line","i":7,"r":"هند","g":"f","a":"teacher","s":74.69,"e":81.62,"d":"لِكُلِّ طَالِبٍ كِتَابَانِ: كِتَابٌ لِلْقِرَاءَةِ وَكِتَابٌ لِلْكِتَابَةِ."},{"k":"card","t":"طالب / طالبة","s":81.62,"e":84.86,"d":"طَالِبٌ، طَالِبَةٌ"},{"k":"ex","t":"يوسف طالب وماريا طالبة.","s":84.86,"e":89.3,"d":"يُوسُفُ طَالِبٌ وَمَارْيَا طَالِبَةٌ."},{"k":"card","t":"طالبان / طالبتان","s":89.3,"e":93.46,"d":"طَالِبَانِ، طَالِبَتَانِ"},{"k":"ex","t":"كين وأحمد طالبان
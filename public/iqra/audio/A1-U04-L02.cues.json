{"v":1,"code":"A1-U04-L02","src":"/iqra/audio/A1-U04-L02.mp3","level":"A1","rate":"-20%","dur":221.5,"cast":"athar-voices-1","cues":[{"k":"intro","s":0.0,"e":18.07,"d":"كَتَبَتْ لَيْلَى لِمَارْيَا وَصْفًا لِحَيِّ الْمَعْهَدِ حَتَّى لَا تَضِيعَ مِثْلَ يُوسُفَ. اقْرَأْهُ وَمَعَكَ وَرَقَةٌ: ارْسُمِ الشَّارِعَ، ثُمَّ ضَعْ كُلَّ مَكَانٍ فِي مَوْضِعِهِ. الْقِرَاءَةُ هُنَا رَسْمٌ."},{"k":"line","i":0,"r":"ليلى","g":"f","a":"woman","s":18.07,"e":23.18,"d":"حَيُّ الْمَعْهَدِ، دَلِيلُ مَارْيَا الصَّغِيرُ."},{"k":"line","i":1,"r":"ليلى","g":"f","a":"woman","s":23.18,"e":31.08,"d":"الْمَعْهَدُ فِي شَارِعِ قُبَاءَ، وَهُوَ شَارِعٌ طَوِيلٌ وَفِيهِ أَشْجَارٌ كَثِيرَةٌ."},{"k":"line","i":2,"r":"ليلى","g":"f","a":"woman","s":31.08,"e":41.14,"d":"أَمَامَ الْمَعْهَدِ مَحَطَّةُ الْحَافِلَاتِ، وَخَلْفَ الْمَعْهَدِ حَدِيقَةٌ صَغِيرَةٌ فِيهَا مَقَاعِدُ وَنَخْلَتَانِ."},{"k":"line","i":3,"r":"ليلى","g":"f","a":"woman","s":41.14,"e":47.11,"d":"عَلَى يَمِينِ الْمَعْهَدِ الْمَقْهَى، وَعَلَى يَسَارِهِ الْبَنْكُ."},{"k":"line","i":4,"r":"ليلى","g":"f","a":"woman","s":47.11,"e":59.76,"d":"بِجَانِبِ الْبَنْكِ الصَّيْدَلِيَّةُ، وَبَعْدَ الصَّيْدَلِيَّةِ الْمَسْجِدُ. الْمَسْجِدُ كَبِيرٌ وَأَبْيَضُ، وَتَسْمَعِينَ الْأَذَانَ مِنَ الصَّفِّ."},{"k":"line","i":5,"r":"ليلى","g":"f","a":"woman","s":59.76,"e":74.59,"d":"السُّوقُ بَعِيدٌ قَلِيلًا: امْشِي مِنَ الْمَعْهَدِ إِلَى الْيَمِينِ خَمْسَ دَقَائِقَ، ثُمَّ اتَّجِهِي إِلَى الْيَسَارِ عِنْدَ الْمَطْعَمِ الْكَبِيرِ. السُّوقُ فِي نِهَايَةِ الشَّارِعِ."},{"k":"line","i":6,"r":"ليلى","g":"f","a":"woman","s":74.59,"e":84.1,"d":"الْمَكْتَبَةُ الْعَامَّةُ لَيْسَتْ فِي شَارِعِ قُبَاءَ؛ هِيَ فِي الشَّارِعِ الْخَلْفِيِّ، خَلْفَ الْحَدِيقَةِ مُبَاشَرَةً."},{"k":"line","i":7,"r":"ليلى","g":"f","a":"woman","s":84.1,"e":96.74,"d":"وَبَيْتُنَا؟ بَيْتُنَا قَرِيبٌ: مِنَ الْمَسْجِدِ اتَّجِهِي إِلَى الْيَمِينِ، الْبَيْتُ الثَّالِثُ عَلَى الْيَسَارِ، بَابُهُ أَخْضَرُ."},{"k":"line","i":8,"r":"ليلى","g":"f","a":"woman","s":96.74,"e":102.6,"d":"وَإِذَا ضِعْتِ، اتَّصِلِي بِي، ل
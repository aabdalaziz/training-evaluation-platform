{"v":1,"code":"A1-U03-L05","src":"/iqra/audio/A1-U03-L05.mp3","level":"A1","rate":"-20%","dur":229.7,"cast":"athar-voices-1","cues":[{"k":"intro","s":0.0,"e":17.18,"d":"أَرْسَلَ كِينْ رِسَالَةً إِلَى أَحْمَدَ وَفِيهَا سِتَّةُ أَسْئِلَةٍ. وَهَذَا رَدُّ أَحْمَدَ. لَاحِظْ كَيْفَ يُجِيبُ أَحْمَدُ عَنِ الْأَسْئِلَةِ بِالتَّرْتِيبِ نَفْسِهِ، وَكَيْفَ يَخْتِمُ بِسُؤَالٍ."},{"k":"line","i":0,"r":"","g":"n","a":"","s":17.18,"e":20.3,"d":"رِسَالَةُ كِينْ:"},{"k":"line","i":1,"r":"كين","g":"m","a":"engineer","s":20.3,"e":23.71,"d":"مَرْحَبًا يَا أَحْمَدُ،"},{"k":"line","i":2,"r":"كين","g":"m","a":"engineer","s":23.71,"e":35.4,"d":"أَنَا كِينْ، زَمِيلُكَ فِي صَفِّ مُكْتَشِفٍ وَاحِدٍ. أَهْلًا بِكَ! عِنْدِي أَسْئِلَةٌ قَصِيرَةٌ:"},{"k":"line","i":3,"r":"كين","g":"m","a":"engineer","s":35.4,"e":53.74,"d":"مِنْ أَيْنَ أَنْتَ فِي مِصْرَ؟ مَا عَمَلُكَ؟ أَيْنَ تَسْكُنُ فِي الْمَدِينَةِ؟ هَلْ عِنْدَكَ سَيَّارَةٌ؟ كَمْ أَخًا عِنْدَكَ؟ وَهَلْ تُحِبُّ الْقَهْوَةَ أَمِ الشَّايَ؟"},{"k":"line","i":4,"r":"كين","g":"m","a":"engineer","s":53.74,"e":57.05,"d":"مَعَ تَحِيَّاتِي،"},{"k":"line","i":5,"r":"كين","g":"m","a":"engineer","s":57.05,"e":59.35,"d":"كِينْ."},{"k":"line","i":7,"r":"","g":"n","a":"","s":59.35,"e":62.18,"d":"رَدُّ أَحْمَدَ:"},{"k":"line","i":8,"r":"أحمد","g":"m","a":"man","s":62.18,"e":67.22,"d":"مَرْحَبًا يَا كِينْ، وَشُكْرًا عَلَى رِسَالَتِكَ!"},{"k":"line","i":9,"r":"أحمد","g":"m","a":"man","s":67.22,"e":99.14,"d":"أَنَا مِنَ الْإِسْكَنْدَرِيَّةِ، وَهِيَ مَدِينَةٌ عَلَى الْبَحْرِ. أَنَا مُوَظَّفٌ فِي بَنْكٍ. أَسْكُنُ فِي شَارِعِ الْعَوَالِي، قَرِيبًا مِنَ الْمَعْهَدِ. لَيْسَ عِنْدِي سَيَّارَةٌ، لَكِنْ عِنْدِي دَرَّاجَةٌ. عِنْدِي أَخٌ وَاحِدٌ وَأُخْتَانِ: أُمِّي مُعَلِّمَةٌ، وَأُخْتِي الْكَبِيرَةُ طَبِيبَةٌ، وَأُخْتِي الصَّغِيرَةُ طَالِبَةٌ. وَأُحِبُّ الشَّايَ، بِالنَّعْنَاعِ!"},{"k":"line","i":10,"r":"أحمد","g":"m","a":"man","s":99.14,"e":107.04,"d":"وَأَنْتَ يَا كِينْ، مِنْ أَيْنَ أَنْتَ فِي الْيَابَانِ؟ وَهَلِ الصَّفُّ صَعْبٌ؟"},{"k":"line","i":11,"r":"أحمد","g":"m","a":
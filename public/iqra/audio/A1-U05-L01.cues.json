{"v":1,"code":"A1-U05-L01","src":"/iqra/audio/A1-U05-L01.mp3","level":"A1","rate":"-20%","dur":260.74,"cast":"athar-voices-1","cues":[{"k":"intro","s":0.0,"e":22.7,"d":"كِينْ يُسَافِرُ إِلَى الرِّيَاضِ فِي عُطْلَةٍ قَصِيرَةٍ لِزِيَارَةِ صَدِيقِهِ أَحْمَدَ الَّذِي يَعْمَلُ هُنَاكَ هَذَا الشَّهْرَ. فِي الْمَطَارِ يَسْمَعُ نِدَاءَاتٍ كَثِيرَةً وَيَرَى لَافِتَاتٍ أَكْثَرَ. اسْمَعْ كُلَّ نِدَاءٍ، وَانْظُرْ: أَيُّ لَافِتَةٍ تَقُولُ الشَّيْءَ نَفْسَهُ؟"},{"k":"line","i":0,"r":"النداء ١","g":"m","a":"man","s":22.7,"e":35.16,"d":"الرِّحْلَةُ رَقْمُ ثَلَاثِمِئَةٍ وَخَمْسَةٍ إِلَى الرِّيَاضِ، الْبَوَّابَةُ رَقْمُ اثْنَيْ عَشَرَ. الرُّكَّابُ الْكِرَامُ، تَفَضَّلُوا إِلَى الْبَوَّابَةِ."},{"k":"line","i":1,"r":"النداء ٢","g":"m","a":"man","s":35.16,"e":43.63,"d":"الرِّحْلَةُ رَقْمُ ثَلَاثِمِئَةٍ وَخَمْسَةٍ مُتَأَخِّرَةٌ ثَلَاثِينَ دَقِيقَةً. نَعْتَذِرُ."},{"k":"line","i":2,"r":"كين","g":"m","a":"engineer","s":43.63,"e":49.46,"d":"مُتَأَخِّرَةٌ؟ طَيِّبٌ، قَهْوَةٌ."},{"k":"line","i":3,"r":"النداء ٣","g":"m","a":"man","s":49.46,"e":54.43,"d":"التَّدْخِينُ مَمْنُوعٌ فِي جَمِيعِ صَالَاتِ الْمَطَارِ."},{"k":"line","i":4,"r":"النداء ٤","g":"m","a":"man","s":54.43,"e":63.67,"d":"الرَّجَاءُ عَدَمُ تَرْكِ الْحَقَائِبِ وَحْدَهَا. الْحَقِيبَةُ الْمَتْرُوكَةُ تُؤْخَذُ إِلَى مَكْتَبِ الْأَمْنِ."},{"k":"line","i":5,"r":"كين","g":"m","a":"engineer","s":63.67,"e":71.81,"d":"حَقِيبَتِي! لَا، هِيَ مَعِي. الْحَمْدُ لِلَّهِ."},{"k":"line","i":6,"r":"النداء ٥","g":"m","a":"man","s":71.81,"e":82.15,"d":"الرَّاكِبَةُ مَارْيَا غَارْثِيَا، الرَّجَاءُ التَّوَجُّهُ إِلَى مَكْتَبِ الِاسْتِعْلَامَاتِ، الدَّوْرُ الْأَرْضِيُّ، بِجَانِبِ الْمِصْعَدِ."},{"k":"line","i":7,"r":"كين","g":"m","a":"engineer","s":82.15,"e":96.07,"d":"مَارْيَا؟ فِي الْمَطَارِ؟! آهْ، هِيَ تُسَافِرُ إِلَى جِدَّةَ الْيَوْمَ مَعَ لَيْلَى وَأُمِّهَا. جَوَازُ سَفَرِهَا!"},{"k":"line","i":8,"r":"النداء ٦","g":"m","a":"man","s":96.07,"e":105.98,"d":"آخِرُ نِدَاءٍ لِلرِّحْلَةِ ثَلَاثِمِئَةٍ وَخَمْسَةٍ. الْبَوَّابَةُ اثْنَا عَشَرَ تُغْلَقُ بَعْد
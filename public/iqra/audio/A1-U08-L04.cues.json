{"v":1,"code":"A1-U08-L04","src":"/iqra/audio/A1-U08-L04.mp3","level":"A1","rate":"-20%","dur":308.45,"cast":"athar-voices-1","cues":[{"k":"intro","s":0.0,"e":38.74,"d":"سُوقُ التُّمُورِ فِي الْمَدِينَةِ الْمُنَوَّرَةِ. لَيْلَى وَمَارْيَا وَعُمَرُ عِنْدَ الْبَائِعِ أَبِي سَعْدٍ وَابْنَتِهِ الْبَائِعَةِ نُوفَ؛ الْجَدُّ حَسَنٌ وَالْجَدَّةُ فَاطِمَةُ طَلَبَا عَجْوَةً، وَأُمُّ لَيْلَى طَلَبَتْ صَفَاوِي لِلْعِيَادَةِ، وَأَبُوهَا خَالِدٌ أَعْطَاهَا مِئَةَ رِيَالٍ. هُنَا تَتَكَلَّمُ الْأَرْقَامُ: السِّعْرُ، الْكَمِّيَّةُ، الْمَجْمُوعُ، الْبَاقِي. وَسَتَتَعَلَّمُ أَيْضًا كَيْفَ تَطْلُبُ سِعْرًا أَحْسَنَ بِأَدَبٍ، وَكَيْفَ يُدَافِعُ عُمَرُ عَنْ حَلْوَاهُ."},{"k":"line","i":0,"r":"","g":"n","a":"","s":38.74,"e":43.3,"d":"الْمَشْهَدُ الْأَوَّلُ: عِنْدَ الْبَائِعِ."},{"k":"line","i":1,"r":"ليلى","g":"f","a":"woman","s":43.3,"e":50.21,"d":"السَّلَامُ عَلَيْكُمْ يَا عَمِّ. بِكَمْ كِيلُو الْعَجْوَةِ؟"},{"k":"line","i":2,"r":"أبو سعد","g":"m","a":"man","s":50.21,"e":58.7,"d":"وَعَلَيْكُمُ السَّلَامُ يَا بِنْتِي. الْعَجْوَةُ بِسِتِّينَ رِيَالًا، وَالصَّفَاوِي بِأَرْبَعِينَ."},{"k":"line","i":3,"r":"ماريا","g":"f","a":"student","s":58.7,"e":64.46,"d":"غَالٍ قَلِيلًا، هَلْ عِنْدَكَ سِعْرٌ أَحْسَنُ؟"},{"k":"line","i":4,"r":"أبو سعد","g":"m","a":"man","s":64.46,"e":69.31,"d":"لَكِ يَا ضَيْفَةَ الْمَدِينَةِ: الْعَجْوَةُ بِخَمْسِينَ."},{"k":"line","i":5,"r":"ماريا","g":"f","a":"student","s":69.31,"e":77.9,"d":"شُكْرًا! كِيلُو عَجْوَةٍ وَنِصْفُ كِيلُو صَفَاوِي، مِنْ فَضْلِكَ."},{"k":"line","i":6,"r":"أبو سعد","g":"m","a":"man","s":77.9,"e":81.96,"d":"نُوفُ، زِنِي الْكِيلُو لِلْبَنَاتِ."},{"k":"line","i":7,"r":"نوف","g":"f","a":"woman","s":81.96,"e":90.67,"d":"الْعَجْوَةُ لِجَدَّتِكِ فَاطِمَةَ يَا لَيْلَى؟ هِيَ تَشْتَرِي مِنَّا دَائِمًا."},{"k":"line","i":8,"r":"ليلى","g":"f","a":"woman","s":90.67,"e":95.57,"d":"نَعَمْ، وَالصَّفَاوِي لِأُمِّي سَارَةَ."},{"k":"line","i":9,"r":"نوف","g":"f","a":"woman","s":95.57,"e":106.27,"d":"كِيلُو عَجْوَةٍ خَمْسُونَ، وَنِصْفُ كِيلُو صَفَاوِي عِشْرُونَ. ال
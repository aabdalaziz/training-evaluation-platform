{"v":1,"code":"A1-U02-L02","src":"/iqra/audio/A1-U02-L02.mp3","level":"A1","rate":"-20%","dur":218.93,"cast":"athar-voices-1","cues":[{"k":"intro","s":0.0,"e":19.27,"d":"تَكْتُبُ مَارْيَا فِي دَفْتَرِهَا عَنْ صَفِّهَا الْجَدِيدِ وَغُرْفَةِ الدَّرْسِ. اقْرَأْ أَوَّلًا لِتَعْرِفَ كَمْ شَخْصًا فِي الصَّفِّ، ثُمَّ اقْرَأْ ثَانِيَةً وَلَاحِظْ كُلَّ كَلِمَةٍ تَنْتَهِي بِالتَّاءِ الْمَرْبُوطَةِ أَوِ الْأَلِفِ وَالنُّونِ أَوِ الْأَلِفِ وَالتَّاءِ."},{"k":"line","i":0,"r":"ماريا","g":"f","a":"student","s":19.27,"e":30.22,"d":"صَفُّنَا فِي الدَّوْرِ الثَّانِي مِنَ الْمَعْهَدِ. الْغُرْفَةُ كَبِيرَةٌ وَفِيهَا نَافِذَتَانِ وَبَابٌ وَاحِدٌ."},{"k":"line","i":1,"r":"ماريا","g":"f","a":"student","s":30.22,"e":39.48,"d":"نَحْنُ اثْنَا عَشَرَ طَالِبًا: سَبْعَةُ طُلَّابٍ وَخَمْسُ طَالِبَاتٍ، مِنْ ثَمَانِي دُوَلٍ."},{"k":"line","i":2,"r":"ماريا","g":"f","a":"student","s":39.48,"e":57.58,"d":"مُعَلِّمَتُنَا اسْمُهَا هِنْدٌ، وَهِيَ مُعَلِّمَةٌ مُمْتَازَةٌ. وَفِي الْمَعْهَدِ مُعَلِّمُونَ آخَرُونَ: الْأُسْتَاذُ أَحْمَدُ يُعَلِّمُ الْكِتَابَةَ، وَالْأُسْتَاذَةُ رِيمُ تُعَلِّمُ الِاسْتِمَاعَ."},{"k":"line","i":3,"r":"ماريا","g":"f","a":"student","s":57.58,"e":70.73,"d":"عَلَى كُلِّ طَاوِلَةٍ كِتَابَانِ وَقَلَمَانِ وَدَفْتَرٌ. وَفِي الْغُرْفَةِ سَاعَةٌ كَبِيرَةٌ وَشَجَرَتَانِ صَغِيرَتَانِ قُرْبَ النَّافِذَةِ."},{"k":"line","i":4,"r":"ماريا","g":"f","a":"student","s":70.73,"e":87.31,"d":"صَدِيقَاتِي فِي الصَّفِّ: لَيْلَى وَنُورُ وَعَائِشَةُ. وَأَصْدِقَائِي: يُوسُفُ وَكِينْ وَعُمَرُ الْكَبِيرُ، وَهُوَ لَيْسَ أَخَا لَيْلَى، بَلْ طَالِبٌ مِنَ السُّودَانِ."},{"k":"line","i":5,"r":"ماريا","g":"f","a":"student","s":87.31,"e":95.64,"d":"أُحِبُّ صَفَّنَا، وَأُحِبُّ مُعَلِّمَتَنَا، وَأُحِبُّ الشَّايَ بَعْدَ الدَّرْسِ!"},{"k":"card","t":"غرفة","s":95.64,"e":98.14,"d":"غُرْفَةٌ"},{"k":"ex","t":"الغرفة كبيرة.","s":98.14,"e":101.28,"d":"الْغُرْفَةُ كَبِيرَةٌ."},{"k":"card","t":"نافذة / نافذتان","s":101.28,"e":105.6,"d":"نَافِذَةٌ، نَافِذَتَانِ"},{"k":"ex","t":"في الغرفة نافذتان.","s":105.6,"e":109.32,"d":"
{"v":1,"code":"A1-U01-L05","src":"/iqra/audio/A1-U01-L05.mp3","level":"A1","rate":"-20%","dur":188.9,"cast":"athar-voices-1","cues":[{"k":"intro","s":0.0,"e":15.17,"d":"تَرُدُّ مَارْيَا عَلَى رِسَالَةِ لَيْلَى بِرِسَالَةٍ عَنْ عَائِلَتِهَا فِي إِسْبَانْيَا. اقْرَأْهَا، وَلَاحِظْ كَيْفَ تَبْدَأُ وَكَيْفَ تَنْتَهِي، وَأَيْنَ تَضَعُ الْفَاصِلَةَ وَالنُّقْطَةَ."},{"k":"line","i":0,"r":"ماريا","g":"f","a":"student","s":15.17,"e":18.41,"d":"عَزِيزَتِي لَيْلَى،"},{"k":"line","i":1,"r":"ماريا","g":"f","a":"student","s":18.41,"e":29.4,"d":"شُكْرًا عَلَى رِسَالَتِكِ الْجَمِيلَةِ. أَنَا مَارْيَا، وَأَنَا مِنْ مَدِينَةِ إِشْبِيلِيَةَ فِي إِسْبَانْيَا."},{"k":"line","i":2,"r":"ماريا","g":"f","a":"student","s":29.4,"e":50.83,"d":"عَائِلَتِي صَغِيرَةٌ: أُمِّي وَأَبِي وَأَخِي وَأَنَا. أُمِّي اسْمُهَا كَارْمِنْ، وَهِيَ مُعَلِّمَةٌ. أَبِي اسْمُهُ بَابْلُو، وَهُوَ طَبِيبٌ. أَخِي عُمْرُهُ خَمْسُ سَنَوَاتٍ، وَهُوَ جَمِيلٌ جِدًّا."},{"k":"line","i":3,"r":"ماريا","g":"f","a":"student","s":50.83,"e":64.85,"d":"أَنَا الْآنَ فِي الْمَدِينَةِ الْمُنَوَّرَةِ، وَأَدْرُسُ الْعَرَبِيَّةَ فِي الْجَامِعَةِ. أَسْكُنُ قَرِيبًا مِنَ الْجَامِعَةِ، وَأُحِبُّ الْمَدِينَةَ كَثِيرًا."},{"k":"line","i":4,"r":"ماريا","g":"f","a":"student","s":64.85,"e":69.72,"d":"وَأَنْتِ، كَمْ عُمْرُ أَخِيكِ عُمَرَ؟"},{"k":"line","i":5,"r":"ماريا","g":"f","a":"student","s":69.72,"e":72.94,"d":"مَعَ تَحِيَّاتِي،"},{"k":"line","i":6,"r":"ماريا","g":"f","a":"student","s":72.94,"e":75.58,"d":"مَارْيَا."},{"k":"card","t":"رسالة","s":75.58,"e":78.19,"d":"رِسَالَةٌ"},{"k":"ex","t":"شكرًا على رسالتك.","s":78.19,"e":81.89,"d":"شُكْرًا عَلَى رِسَالَتِكِ."},{"k":"card","t":"عزيزي / عزيزتي","s":81.89,"e":86.09,"d":"عَزِيزِي، عَزِيزَتِي"},{"k":"ex","t":"عزيزتي ليلى،","s":86.09,"e":89.3,"d":"عَزِيزَتِي لَيْلَى،"},{"k":"card","t":"مع تحيّاتي","s":89.3,"e":92.47,"d":"مَعَ تَحِيَّاتِي،"},{"k":"ex","t":"مع تحيّاتي، ماريا","s":92.47,"e":96.74,"d":"مَعَ تَحِيَّاتِي، مَارْيَا"},{"k":"card","t":"شكرًا على","s":96.74,"e":99.5,"d":"شُكْرًا عَلَى"}
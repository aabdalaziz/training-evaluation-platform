{"v":1,"code":"A1-U04-L05","src":"/iqra/audio/A1-U04-L05.mp3","level":"A1","rate":"-20%","dur":233.95,"cast":"athar-voices-1","cues":[{"k":"intro","s":0.0,"e":21.62,"d":"غَدَاءُ الْجُمُعَةِ عِنْدَ الْجَدَّةِ فَاطِمَةَ! تُرْسِلُ لَيْلَى إِلَى مَارْيَا وَيُوسُفَ وَكِينْ رِسَالَةً وَاحِدَةً فِيهَا الطَّرِيقُ. لَاحِظْ: الْخُطُوَاتُ مُرَقَّمَةٌ، وَفِعْلُ الْأَمْرِ هُنَا لِلْجَمَاعَةِ، وَفِي النِّهَايَةِ مَا يَفْعَلُهُ مَنْ يَضِيعُ."},{"k":"line","i":0,"r":"ليلى","g":"f","a":"woman","s":21.62,"e":25.06,"d":"مَرْحَبًا يَا أَصْدِقَاءُ،"},{"k":"line","i":1,"r":"ليلى","g":"f","a":"woman","s":25.06,"e":36.02,"d":"الْغَدَاءُ يَوْمَ الْجُمُعَةِ فِي بَيْتِ جَدَّتِي فَاطِمَةَ، فِي السَّاعَةِ الثَّانِيَةِ. هَذَا هُوَ الطَّرِيقُ مِنَ الْمَعْهَدِ:"},{"k":"line","i":2,"r":"ليلى","g":"f","a":"woman","s":36.02,"e":42.46,"d":"أَوَّلًا: اخْرُجُوا مِنَ الْمَعْهَدِ وَاتَّجِهُوا إِلَى الْيَسَارِ."},{"k":"line","i":3,"r":"ليلى","g":"f","a":"woman","s":42.46,"e":51.14,"d":"ثَانِيًا: امْشُوا فِي شَارِعِ قُبَاءَ حَتَّى الْمَسْجِدِ الْكَبِيرِ الْأَبْيَضِ، خَمْسَ دَقَائِقَ."},{"k":"line","i":4,"r":"ليلى","g":"f","a":"woman","s":51.14,"e":59.69,"d":"ثَالِثًا: عِنْدَ الْمَسْجِدِ اتَّجِهُوا إِلَى الْيَمِينِ، فِي شَارِعٍ صَغِيرٍ فِيهِ أَشْجَارٌ."},{"k":"line","i":5,"r":"ليلى","g":"f","a":"woman","s":59.69,"e":72.89,"d":"رَابِعًا: بَيْتُ جَدَّتِي هُوَ الْبَيْتُ الثَّانِي عَلَى الْيَمِينِ، بِجَانِبِ بَيْتِنَا. بَابُهُ بُنِّيٌّ، وَأَمَامَهُ نَخْلَةٌ كَبِيرَةٌ."},{"k":"line","i":6,"r":"ليلى","g":"f","a":"woman","s":72.89,"e":80.78,"d":"خَامِسًا: الْجَرَسُ عَلَى يَسَارِ الْبَابِ. اضْغَطُوا مَرَّتَيْنِ!"},{"k":"line","i":7,"r":"ليلى","g":"f","a":"woman","s":80.78,"e":92.59,"d":"الْمَسَافَةُ كُلُّهَا عَشْرُ دَقَائِقَ مَشْيًا. لَا تَأْتُوا بِالسَّيَّارَةِ: الشَّارِعُ ضَيِّقٌ وَلَا مَكَانَ لِلْوُقُوفِ."},{"k":"line","i":8,"r":"ليلى","g":"f","a":"woman","s":92.59,"e":104.14,"d":"وَإِذَا ضِعْتُمْ، اتَّصِلُوا بِي أَوْ بِعُمَرَ، هُوَ أَمَامَ الْبَيْتِ مِنَ السَّاعَةِ الْوَاحِدَةِ وَالنِّصْفِ، مَعَ كُرَتِهِ طَبْعًا."},{"k":"line","i":9,"r":"ليلى","g":"f","a":"woman","s":104.14,"e":111.07,"d":"لَا تَتَأَخَّرُوا! جَدَّتِي لَا تُحِبُّ الطَّعَامَ الْبَارِدَ."},{"k":"line","i":10,"r":"ليلى","g":"f","a":"woman","s":111.07,"e":114.14,"d":"مَعَ تَحِيَّاتِي،"},{"k":"line","i":11,"r":"ليلى","g":"f","a":"woman","s":114.14,"e":116.47,"d":"لَيْلَى."},{"k":"card","t":"طريق","s":116.47,"e":118.87,"d":"طَرِيقٌ"},{"k":"ex","t":"هذا هو الطريق من المعهد.","s":118.87,"e":123.02,"d":"هَذَا هُوَ الطَّرِيقُ مِنَ الْمَعْهَدِ."},{"k":"card","t":"نحو","s":123.02,"e":125.3,"d":"نَحْوَ"},{"k":"ex","t":"نحو البنك.","s":125.3,"e":128.11,"d":"نَحْوَ الْبَنْكِ."},{"k":"card","t":"حتى","s":128.11,"e":130.39,"d":"حَتَّى"},{"k":"ex","t":"امشوا حتى المسجد.","s":130.39,"e":133.87,"d":"امْشُوا حَتَّى الْمَسْجِدِ."},{"k":"card","t":"ضيّق / ضيّقة","s":133.87,"e":137.52,"d":"ضَيِّقٌ، ضَيِّقَةٌ"},{"k":"ex","t":"الشارع ضيّق.","s":137.52,"e":140.59,"d":"الشَّارِعُ ضَيِّقٌ."},{"k":"card","t":"مكان للوقوف","s":140.59,"e":144.02,"d":"مَكَانٌ لِلْوُقُوفِ"},{"k":"ex","t":"لا مكان للوقوف.","s":144.02,"e":147.67,"d":"لَا مَكَانَ لِلْوُقُوفِ."},{"k":"card","t":"جرس","s":147.67,"e":150.12,"d":"جَرَسٌ"},{"k":"ex","t":"الجرس على يسار الباب.","s":150.12,"e":154.06,"d":"الْجَرَسُ عَلَى يَسَارِ الْبَابِ."},{"k":"card","t":"اضغط / اضغطوا","s":154.06,"e":157.46,"d":"اضْغَطْ، اضْغَطُوا"},{"k":"ex","t":"اضغطوا مرّتين.","s":157.46,"e":160.82,"d":"اضْغَطُوا مَرَّتَيْنِ."},{"k":"card","t":"بنّيّ / بنّيّة","s":160.82,"e":164.35,"d":"بُنِّيٌّ، بُنِّيَّةٌ"},{"k":"ex","t":"بابه بنّيّ.","s":164.35,"e":167.3,"d":"بَابُهُ بُنِّيٌّ."},{"k":"card","t":"مسافة","s":167.3,"e":169.92,"d":"مَسَافَةٌ"},{"k":"ex","t":"المسافة عشر دقائق.","s":169.92,"e":173.93,"d":"الْمَسَافَةُ عَشْرُ دَقَائِقَ."},{"k":"card","t":"تأخّر / لا تتأخّروا","s":173.93,"e":178.27,"d":"تَأَخَّرَ، لَا تَتَأَخَّرُوا"},{"k":"ex","t":"لا تتأخّروا!","s":178.27,"e":181.3,"d":"لَا تَتَأَخَّرُوا!"},{"k":"card","t":"بارد / باردة","s":181.3,"e":184.87,"d":"بَارِدٌ، بَارِدَةٌ"},{"k":"ex","t"
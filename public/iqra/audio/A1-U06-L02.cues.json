{"v":1,"code":"A1-U06-L02","src":"/iqra/audio/A1-U06-L02.mp3","level":"A1","rate":"-20%","dur":254.52,"cast":"athar-voices-1","cues":[{"k":"intro","s":0.0,"e":23.45,"d":"رِحْلَةٌ إِلَى مَسْجِدِ قُبَاءَ يَوْمَ الْجُمُعَةِ. هَذِهِ مُحَادَثَةُ الْمَجْمُوعَةِ كَامِلَةً، اثْنَتَا عَشْرَةَ رِسَالَةً. الْمَوْعِدُ تَغَيَّرَ مَرَّتَيْنِ! اقْرَأْ حَتَّى النِّهَايَةِ قَبْلَ أَنْ تُجِيبَ: مَتَى؟ أَيْنَ؟ مَنْ يَأْتِي؟"},{"k":"line","i":0,"r":"ليلى","g":"f","a":"woman","s":23.45,"e":36.55,"d":"مَرْحَبًا يَا جَمَاعَةُ، مَنْ يُرِيدُ زِيَارَةَ مَسْجِدِ قُبَاءَ يَوْمَ الْجُمُعَةِ بَعْدَ الصَّلَاةِ؟ نَلْتَقِي أَمَامَ الْمَعْهَدِ فِي السَّاعَةِ الثَّانِيَةِ."},{"k":"line","i":1,"r":"ماريا","g":"f","a":"student","s":36.55,"e":40.92,"d":"أَنَا! أَكِيدٌ."},{"k":"line","i":2,"r":"يوسف","g":"m","a":"doctor","s":40.92,"e":45.79,"d":"وَأَنَا. هَلْ نَذْهَبُ مَشْيًا؟"},{"k":"line","i":3,"r":"ليلى","g":"f","a":"woman","s":45.79,"e":52.03,"d":"لَا، بِالْحَافِلَةِ رَقْمِ سَبْعَةٍ، عَشْرُ دَقَائِقَ."},{"k":"line","i":4,"r":"كين","g":"m","a":"engineer","s":52.03,"e":61.54,"d":"آسِفٌ، الْجُمُعَةَ عِنْدِي مَوْعِدٌ عِنْدَ الطَّبِيبِ فِي الثَّانِيَةِ. هَلْ مُمْكِنٌ الثَّالِثَةُ؟"},{"k":"line","i":5,"r":"ليلى","g":"f","a":"woman","s":61.54,"e":68.66,"d":"مُمْكِنٌ. الْمَوْعِدُ الْجَدِيدُ: السَّاعَةُ الثَّالِثَةُ."},{"k":"line","i":6,"r":"أحمد","g":"m","a":"man","s":68.66,"e":77.66,"d":"أَنَا آتِي بَعْدَ الْعَمَلِ، سَأَكُونُ هُنَاكَ فِي الثَّالِثَةِ وَالنِّصْفِ. ابْدَؤُوا بِدُونِي."},{"k":"line","i":7,"r":"ريم","g":"f","a":"woman","s":77.66,"e":85.22,"d":"أَنَا مَا أَقْدِرُ، عِنْدِي ضُيُوفٌ. الْمَرَّةَ الْقَادِمَةَ إِنْ شَاءَ اللَّهُ."},{"k":"line","i":8,"r":"ماريا","g":"f","a":"student","s":85.22,"e":90.41,"d":"خَسَارَةٌ! سَنَفْتَقِدُكِ."},{"k":"line","i":9,"r":"هند","g":"f","a":"teacher","s":90.41,"e":100.8,"d":"فِكْرَةٌ مُمْتَازَةٌ! تَذَكَّرُوا: الْمَلَابِسَ الْمُحْتَشِمَةَ، وَالْمَاءَ، وَلَا تَتَأَخَّرُوا عَنِ الْحَافِلَةِ."},{"k":"line","i":10,"r":"ليلى","g":"f","a":"woman","s":100.8,"e":117.17,"d":"ت
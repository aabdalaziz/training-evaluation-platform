{
 "أوّل أصوات العربية في مستواك: أربعة أشخاص يعرّفون بأنفسهم في أوّل يوم لهم في المدينة المنوّرة. اسمع مرّتين قبل أن تقرأ، ثم اقرأ وأنت تسمع.": "أَوَّلُ أَصْوَاتِ الْعَرَبِيَّةِ فِي مُسْتَوَاكَ: أَرْبَعَةُ أَشْخَاصٍ يُعَرِّفُونَ بِأَنْفُسِهِمْ فِي أَوَّلِ يَوْمٍ لَهُمْ فِي الْمَدِينَةِ الْمُنَوَّرَةِ. اسْمَعْ مَرَّتَيْنِ قَبْلَ أَنْ تَقْرَأَ، ثُمَّ اقْرَأْ وَأَنْتَ تَسْمَعُ.",
 "السلام عليكم، أنا هند. أنا معلّمة من المدينة. وأنتِ؟": "السَّلَامُ عَلَيْكُمْ، أَنَا هِنْدٌ. أَنَا مُعَلِّمَةٌ مِنَ الْمَدِينَةِ. وَأَنْتِ؟",
 "وعليكم السلام. أنا ماريا، أنا من إسبانيا. أنا طالبة.": "وَعَلَيْكُمُ السَّلَامُ. أَنَا مَارْيَا، أَنَا مِنْ إِسْبَانْيَا. أَنَا طَالِبَةٌ.",
 "أهلًا ماريا. وأنتَ؟": "أَهْلًا مَارْيَا. وَأَنْتَ؟",
 "أنا يوسف، أنا من نيجيريا. أنا طبيب.": "أَنَا يُوسُفُ، أَنَا مِنْ نَيْجِيرْيَا. أَنَا طَبِيبٌ.",
 "أهلًا وسهلًا. وأنتَ يا أخي؟": "أَهْلًا وَسَهْلًا. وَأَنْتَ يَا أَخِي؟",
 "اسمي كين. أنا من اليابان. أنا مهندس.": "اسْمِي كِينْ. أَنَا مِنَ الْيَابَانِ. أَنَا مُهَنْدِسٌ.",
 "أهلًا بكم جميعًا في المدينة.": "أَهْلًا بِكُمْ جَمِيعًا فِي الْمَدِينَةِ.",
 "أنا": "أَنَا",
 "أنا ليلى.": "أَنَا لَيْلَى.",
 "أنتَ": "أَنْتَ",
 "من أين أنتَ يا يوسف؟": "مِنْ أَيْنَ أَنْتَ يَا يُوسُفُ؟",
 "أنتِ": "أَنْتِ",
 "أنتِ معلّمة يا هند؟": "أَنْتِ مُعَلِّمَةٌ يَا هِنْدُ؟",
 "هو": "هُوَ",
 "هو مهندس من اليابان.": "هُوَ مُهَنْدِسٌ مِنَ الْيَابَانِ.",
 "هي": "هِيَ",
 "هي طبيبة في المستشفى.": "هِيَ طَبِيبَةٌ فِي الْمُسْتَشْفَى.",
 "من أين؟": "مِنْ أَيْنَ؟",
 "من أين أنتِ؟ ، أنا من إسبانيا.": "مِنْ أَيْنَ أَنْتِ؟ أَنَا مِنْ إِسْبَانْيَا.",
 "اسم": "اسْمٌ",
 "اسمي كين.": "اسْمِي كِينْ.",
 "بلد": "بَلَدٌ",
 "ما بلدك؟": "مَا بَلَدُكَ؟",
 "مدينة": "مَدِينَةٌ",
 "المدينة المنوّرة مدينة جميلة.": "الْمَدِينَةُ الْمُنَوَّرَةُ مَدِينَةٌ جَمِيلَةٌ.",
 "طبيب، طبيبة": "طَبِيبٌ، طَبِيبَةٌ",
 "سارة طبيبة ويوسف طبيب.": "سَارَةُ طَبِيبَةٌ وَيُوسُفُ طَبِيبٌ.",
 "مهندس، مهندسة": "مُهَنْدِسٌ، مُهَنْدِسَةٌ",
 "خالد مهندس.": "خَالِدٌ مُهَنْدِسٌ.",
 "معلّم، معلّمة": "مُعَلِّمٌ، مُعَلِّمَةٌ",
 "هند معلّمة.": "هِنْدٌ مُعَلِّمَةٌ.",
 "طالب، طالبة": "طَالِبٌ، طَالِبَةٌ",
 "ليلى طالبة وماريا طالبة.": "لَيْلَى طَالِبَةٌ وَمَارْيَا طَالِبَةٌ.",
 "أهلًا وسهلًا": "أَهْلًا وَسَهْلًا",
 "أهلًا وسهلًا بكم في المدينة.": "أَهْلًا وَسَهْلًا بِكُمْ فِي الْمَدِينَةِ.",
 "أنا ماريا، أنا من إسبانيا.": "أَنَا مَارْيَا، أَنَا مِنْ إِسْبَانْيَا.",
 "من أين أنتَ يا يوسف؟ ، أنا من نيجيريا.": "مِنْ أَيْنَ أَنْتَ يَا يُوسُفُ؟ أَنَا مِنْ نَيْجِيرْيَا.",
 "هي معلّمة، وهو مهندس.": "هِيَ مُعَلِّمَةٌ، وَهُوَ مُهَنْدِسٌ.",
 "هي تعمل في المستشفى": "هِيَ تَعْمَلُ فِي الْمُسْتَشْفَى",
 "هو يبني البيوت والجسور": "هُوَ يَبْنِي الْبُيُوتَ وَالْجُسُورَ",
 "أنا طالبة في الجامعة": "أَنَا طَالِبَةٌ فِي الْجَامِعَةِ",
 "أنا من إسبانيا": "أَنَا مِنْ إِسْبَانْيَا",
 "هي معلّمة من المدينة": "هِيَ مُعَلِّمَةٌ مِنَ الْمَدِينَةِ",
 "من أين أنت؟": "مِنْ أَيْنَ أَنْتَ؟"
}

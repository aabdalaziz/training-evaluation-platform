{
"في مكتب التسجيل بالمعهد تسأل الموظّفة نورة الطالبَ الجديد يوسف أسئلة قصيرة لتملأ البطاقة. كلّ سؤال يبدأ بكلمة صغيرة تخبرك بنوع الجواب: من → شخص، ما → شيء، أين → مكان، كم → عدد، هل → نعم أو لا.": "فِي مَكْتَبِ التَّسْجِيلِ بِالْمَعْهَدِ تَسْأَلُ الْمُوَظَّفَةُ نُورَةُ الطَّالِبَ الْجَدِيدَ يُوسُفَ أَسْئِلَةً قَصِيرَةً لِتَمْلَأَ الْبِطَاقَةَ. كُلُّ سُؤَالٍ يَبْدَأُ بِكَلِمَةٍ صَغِيرَةٍ تُخْبِرُكَ بِنَوْعِ الْجَوَابِ: مَنْ لِلشَّخْصِ، وَمَا لِلشَّيْءِ، وَأَيْنَ لِلْمَكَانِ، وَكَمْ لِلْعَدَدِ، وَهَلْ لِنَعَمْ أَوْ لَا.",
"صباح الخير. ما اسمك؟": "صَبَاحُ الْخَيْرِ. مَا اسْمُكَ؟",
"اسمي يوسف أديبايو.": "اسْمِي يُوسُفُ أَدِيبَايُو.",
"أنا من نيجيريا، من مدينة كانو.": "أَنَا مِنْ نَيْجِيرْيَا، مِنْ مَدِينَةِ كَانُو.",
"وأين تسكن الآن؟": "وَأَيْنَ تَسْكُنُ الْآنَ؟",
"أسكن في سكن المعهد، في الغرفة رقم خمسة.": "أَسْكُنُ فِي سَكَنِ الْمَعْهَدِ، فِي الْغُرْفَةِ رَقْمِ خَمْسَةٍ.",
"ما عملك؟": "مَا عَمَلُكَ؟",
"أنا طبيب.": "أَنَا طَبِيبٌ.",
"كم عمرك؟": "كَمْ عُمْرُكَ؟",
"عمري ثلاثون سنة.": "عُمْرِي ثَلَاثُونَ سَنَةً.",
"هل أنت متزوّج؟": "هَلْ أَنْتَ مُتَزَوِّجٌ؟",
"نعم، أنا متزوّج، وعندي بنت واحدة.": "نَعَمْ، أَنَا مُتَزَوِّجٌ، وَعِنْدِي بِنْتٌ وَاحِدَةٌ.",
"ما رقم هاتفك؟": "مَا رَقْمُ هَاتِفِكَ؟",
"صفر خمسة خمسة، اثنان ثلاثة أربعة، سبعة ثمانية تسعة واحد.": "صِفْرٌ خَمْسَةٌ خَمْسَةٌ، اثْنَانِ ثَلَاثَةٌ أَرْبَعَةٌ، سَبْعَةٌ ثَمَانِيَةٌ تِسْعَةٌ وَاحِدٌ.",
"شكرًا. من معلّمتك؟": "شُكْرًا. مَنْ مُعَلِّمَتُكَ؟",
"الأستاذة هند.": "الْأُسْتَاذَةُ هِنْدٌ.",
"ممتاز. أهلًا بك في المعهد يا دكتور يوسف.": "مُمْتَازٌ. أَهْلًا بِكَ فِي الْمَعْهَدِ يَا دُكْتُورْ يُوسُفُ.",
"من؟": "مَنْ؟",
"من معلّمتك؟": "مَنْ مُعَلِّمَتُكَ؟",
"ما؟": "مَا؟",
"ما اسمك؟": "مَا اسْمُكَ؟",
"أين؟": "أَيْنَ؟",
"أين تسكن؟": "أَيْنَ تَسْكُنُ؟",
"نعم، لا": "نَعَمْ، لَا",
"نعم، أنا طبيب.": "نَعَمْ، أَنَا طَبِيبٌ.",
"تسجيل": "تَسْجِيلٌ",
"مكتب التسجيل.": "مَكْتَبُ التَّسْجِيلِ.",
"نورة موظّفة التسجيل.": "نُورَةُ مُوَظَّفَةُ التَّسْجِيلِ.",
"سكن": "سَكَنٌ",
"أسكن في سكن المعهد.": "أَسْكُنُ فِي سَكَنِ الْمَعْهَدِ.",
"رقم، أرقام": "رَقْمٌ، أَرْقَامٌ",
"الغرفة رقم خمسة.": "الْغُرْفَةُ رَقْمُ خَمْسَةٍ.",
"متزوّج، متزوّجة": "مُتَزَوِّجٌ، مُتَزَوِّجَةٌ",
"هاتف، رقم الهاتف": "هَاتِفٌ، رَقْمُ الْهَاتِفِ",
"دكتور، دكتورة": "دُكْتُورٌ، دُكْتُورَةٌ",
"أهلًا يا دكتور يوسف.": "أَهْلًا يَا دُكْتُورْ يُوسُفُ.",
"ما اسمك؟ ، اسمي يوسف.": "مَا اسْمُكَ؟ اسْمِي يُوسُفُ.",
"أين تسكن؟ ، في سكن المعهد.": "أَيْنَ تَسْكُنُ؟ فِي سَكَنِ الْمَعْهَدِ.",
"هل أنت متزوّج؟ ، نعم.": "هَلْ أَنْتَ مُتَزَوِّجٌ؟ نَعَمْ.",
"من هذه؟ ، هذه موظّفة التسجيل": "مَنْ هَذِهِ؟ هَذِهِ مُوَظَّفَةُ التَّسْجِيلِ",
"أين تسكن؟ ، في سكن المعهد": "أَيْنَ تَسْكُنُ؟ فِي سَكَنِ الْمَعْهَدِ",
"ما عملك؟ ، أنا طبيب": "مَا عَمَلُكَ؟ أَنَا طَبِيبٌ",
"عمري ثلاثون سنة": "عُمْرِي ثَلَاثُونَ سَنَةً"
}

{
 "تُري ليلى صديقتها ماريا صور العائلة على الهاتف. الجملة العربية البسيطة لا تحتاج إلى فعل: هذا أبي، هذه أمّي ، كلمتان وتكتمل الجملة.": "تُرِي لَيْلَى صَدِيقَتَهَا مَارْيَا صُوَرَ الْعَائِلَةِ عَلَى الْهَاتِفِ. الْجُمْلَةُ الْعَرَبِيَّةُ الْبَسِيطَةُ لَا تَحْتَاجُ إِلَى فِعْلٍ: هَذَا أَبِي، هَذِهِ أُمِّي. كَلِمَتَانِ وَتَكْتَمِلُ الْجُمْلَةُ.",
 "من هذا؟": "مَنْ هَذَا؟",
 "هذا أبي. اسمه خالد، وهو مهندس.": "هَذَا أَبِي. اسْمُهُ خَالِدٌ، وَهُوَ مُهَنْدِسٌ.",
 "ومن هذه؟": "وَمَنْ هَذِهِ؟",
 "هذه أمّي سارة. هي طبيبة.": "هَذِهِ أُمِّي سَارَةُ. هِيَ طَبِيبَةٌ.",
 "وهذا الولد الصغير؟": "وَهَذَا الْوَلَدُ الصَّغِيرُ؟",
 "هذا أخي عمر. وهذه جدّتي فاطمة، وهذا جدّي حسن.": "هَذَا أَخِي عُمَرُ. وَهَذِهِ جَدَّتِي فَاطِمَةُ، وَهَذَا جَدِّي حَسَنٌ.",
 "ما هذا؟": "مَا هَذَا؟",
 "هذا بيتنا، وهذه سيّارة أبي.": "هَذَا بَيْتُنَا، وَهَذِهِ سَيَّارَةُ أَبِي.",
 "عائلة جميلة!": "عَائِلَةٌ جَمِيلَةٌ!",
 "هذا": "هَذَا",
 "هذا أبي.": "هَذَا أَبِي.",
 "هذه": "هَذِهِ",
 "هذه أمّي.": "هَذِهِ أُمِّي.",
 "من هذا؟ ، هذا جدّي.": "مَنْ هَذَا؟ هَذَا جَدِّي.",
 "ما هذا؟ ، هذا هاتف.": "مَا هَذَا؟ هَذَا هَاتِفٌ.",
 "ولد": "وَلَدٌ",
 "هذا ولد صغير.": "هَذَا وَلَدٌ صَغِيرٌ.",
 "بنت": "بِنْتٌ",
 "هذه بنت جميلة.": "هَذِهِ بِنْتٌ جَمِيلَةٌ.",
 "سيّارة": "سَيَّارَةٌ",
 "هذه سيّارة أبي.": "هَذِهِ سَيَّارَةُ أَبِي.",
 "هاتف": "هَاتِفٌ",
 "هذا هاتفي.": "هَذَا هَاتِفِي.",
 "كتاب": "كِتَابٌ",
 "هذا كتاب عربيّ.": "هَذَا كِتَابٌ عَرَبِيٌّ.",
 "مدرسة": "مَدْرَسَةٌ",
 "هذه مدرسة عمر.": "هَذِهِ مَدْرَسَةُ عُمَرَ.",
 "جميل، جميلة": "جَمِيلٌ، جَمِيلَةٌ",
 "جديد، جديدة": "جَدِيدٌ، جَدِيدَةٌ",
 "هذه سيّارة جديدة.": "هَذِهِ سَيَّارَةٌ جَدِيدَةٌ.",
 "صورة": "صُورَةٌ",
 "هذه صورة عائلتي.": "هَذِهِ صُورَةُ عَائِلَتِي.",
 "هذا أخي، وهذه أختي.": "هَذَا أَخِي، وَهَذِهِ أُخْتِي.",
 "هذه سيّارة كبيرة.": "هَذِهِ سَيَّارَةٌ كَبِيرَةٌ.",
 "ما هذا؟ ، هذا كتاب.": "مَا هَذَا؟ هَذَا كِتَابٌ.",
 "هذا أبي وهذه أمّي": "هَذَا أَبِي وَهَذِهِ أُمِّي",
 "هذه سيّارة جديدة": "هَذِهِ سَيَّارَةٌ جَدِيدَةٌ"
}

{
"عمر أخو ليلى يبحث عن كرته في البيت، والجدّة فاطمة تساعده بالأسئلة لا بالأجوبة. حوار قصير فيه كلّ حروف المكان: اقرأه ثمّ انظر إلى الصور في المِران.": "عُمَرُ أَخُو لَيْلَى يَبْحَثُ عَنْ كُرَتِهِ فِي الْبَيْتِ، وَالْجَدَّةُ فَاطِمَةُ تُسَاعِدُهُ بِالْأَسْئِلَةِ لَا بِالْأَجْوِبَةِ. حِوَارٌ قَصِيرٌ فِيهِ كُلُّ حُرُوفِ الْمَكَانِ: اقْرَأْهُ ثُمَّ انْظُرْ إِلَى الصُّوَرِ فِي الْمِرَانِ.",
"يا جدّتي، أين كرتي؟": "يَا جَدَّتِي، أَيْنَ كُرَتِي؟",
"هل هي على الطاولة؟": "هَلْ هِيَ عَلَى الطَّاوِلَةِ؟",
"لا، على الطاولة كتب أمّي فقط.": "لَا، عَلَى الطَّاوِلَةِ كُتُبُ أُمِّي فَقَطْ.",
"هل هي تحت السرير؟": "هَلْ هِيَ تَحْتَ السَّرِيرِ؟",
"لا، تحت السرير حذائي وجوربان!": "لَا، تَحْتَ السَّرِيرِ حِذَائِي وَجَوْرَبَانِ!",
"هل هي في الحقيبة؟": "هَلْ هِيَ فِي الْحَقِيبَةِ؟",
"الحقيبة فارغة.": "الْحَقِيبَةُ فَارِغَةٌ.",
"انظر خلف الباب.": "انْظُرْ خَلْفَ الْبَابِ.",
"خلف الباب معطف أبي.": "خَلْفَ الْبَابِ مِعْطَفُ أَبِي.",
"وبجانب الكرسيّ؟": "وَبِجَانِبِ الْكُرْسِيِّ؟",
"بجانب الكرسيّ قطّة الجيران!": "بِجَانِبِ الْكُرْسِيِّ قِطَّةُ الْجِيرَانِ!",
"وبين الكرسيّ والنافذة؟": "وَبَيْنَ الْكُرْسِيِّ وَالنَّافِذَةِ؟",
"الكرة! بين الكرسيّ والنافذة. شكرًا يا جدّتي!": "الْكُرَةُ! بَيْنَ الْكُرْسِيِّ وَالنَّافِذَةِ. شُكْرًا يَا جَدَّتِي!",
"أنا لم أجدها، أنت وجدتها. والآن الكرة في يدك، فاذهب والعب أمام البيت، لا فيه.": "أَنَا لَمْ أَجِدْهَا، أَنْتَ وَجَدْتَهَا. وَالْآنَ الْكُرَةُ فِي يَدِكَ، فَاذْهَبْ وَالْعَبْ أَمَامَ الْبَيْتِ، لَا فِيهِ.",
"وأنا؟ أنا كنت أعرف مكانها من البداية! هو خلف جريدتي!": "وَأَنَا؟ أَنَا كُنْتُ أَعْرِفُ مَكَانَهَا مِنَ الْبِدَايَةِ! هُوَ خَلْفَ جَرِيدَتِي!",
"جدّي! أنت لم تقل شيئًا!": "جَدِّي! أَنْتَ لَمْ تَقُلْ شَيْئًا!",
"تحت": "تَحْتَ",
"تحت السرير حذائي.": "تَحْتَ السَّرِيرِ حِذَائِي.",
"فوق": "فَوْقَ",
"فوق الطاولة مصباح.": "فَوْقَ الطَّاوِلَةِ مِصْبَاحٌ.",
"بين": "بَيْنَ",
"بين الكرسيّ والنافذة.": "بَيْنَ الْكُرْسِيِّ وَالنَّافِذَةِ.",
"كرة": "كُرَةٌ",
"كرة أخي عمر تحت السرير.": "كُرَةُ أَخِي عُمَرَ تَحْتَ السَّرِيرِ.",
"سرير": "سَرِيرٌ",
"سرير جدّتي كبير.": "سَرِيرُ جَدَّتِي كَبِيرٌ.",
"كرسيّ": "كُرْسِيٌّ",
"بجانب الكرسيّ.": "بِجَانِبِ الْكُرْسِيِّ.",
"نافذة": "نَافِذَةٌ",
"أمّي بجانب النافذة.": "أُمِّي بِجَانِبِ النَّافِذَةِ.",
"حذاء": "حِذَاءٌ",
"حذاء أبي خلف الباب.": "حِذَاءُ أَبِي خَلْفَ الْبَابِ.",
"جورب، جوربان": "جَوْرَبٌ، جَوْرَبَانِ",
"جوربان.": "جَوْرَبَانِ.",
"معطف": "مِعْطَفٌ",
"معطف أبي خلف الباب.": "مِعْطَفُ أَبِي خَلْفَ الْبَابِ.",
"قطّة": "قِطَّةٌ",
"هي قطّة الجيران.": "هِيَ قِطَّةُ الْجِيرَانِ.",
"جيران": "جِيرَانٌ",
"جارنا أحمد موظّف في البنك.": "جَارُنَا أَحْمَدُ مُوَظَّفٌ فِي الْبَنْكِ.",
"يد، في يدك": "يَدٌ، فِي يَدِكَ",
"الكرة في يد عمر.": "الْكُرَةُ فِي يَدِ عُمَرَ.",
"وجد، وجدتها": "وَجَدَ، وَجَدْتَهَا",
"ليلى وجدتها.": "لَيْلَى وَجَدَتْهَا.",
"الكرة بين الكرسيّ والنافذة.": "الْكُرَةُ بَيْنَ الْكُرْسِيِّ وَالنَّافِذَةِ.",
"تحت السرير حذائي وجوربان.": "تَحْتَ السَّرِيرِ حِذَائِي وَجَوْرَبَانِ.",
"الكرة في يدك، فالعب أمام البيت، لا فيه.": "الْكُرَةُ فِي يَدِكَ، فَالْعَبْ أَمَامَ الْبَيْتِ، لَا فِيهِ.",
"تحت السرير": "تَحْتَ السَّرِيرِ",
"بين الكرسيّ والنافذة": "بَيْنَ الْكُرْسِيِّ وَالنَّافِذَةِ",
"أين كرتي؟": "أَيْنَ كُرَتِي؟"
}

{
"يلعب كين ويوسف لعبة في الاستراحة: يقول أحدهما كلمة ويقول الآخر مثنّاها وجمعها. العب معهما، والقاعدة في محطّة القاعدة إذا احترت.": "يَلْعَبُ كِينْ وَيُوسُفُ لُعْبَةً فِي الِاسْتِرَاحَةِ: يَقُولُ أَحَدُهُمَا كَلِمَةً وَيَقُولُ الْآخَرُ مُثَنَّاهَا وَجَمْعَهَا. الْعَبْ مَعَهُمَا، وَالْقَاعِدَةُ فِي مَحَطَّةِ الْقَاعِدَةِ إِذَا احْتَرْتَ.",
"طالب!": "طَالِبٌ!",
"طالبان، طلّاب!": "طَالِبَانِ، طُلَّابٌ!",
"طالبة!": "طَالِبَةٌ!",
"طالبتان، طالبات! دورك: معلّمة!": "طَالِبَتَانِ، طَالِبَاتٌ! دَوْرُكَ: مُعَلِّمَةٌ!",
"معلّمتان، معلّمات. وكتاب؟": "مُعَلِّمَتَانِ، مُعَلِّمَاتٌ. وَكِتَابٌ؟",
"كتابان، كتب. وبيت؟": "كِتَابَانِ، كُتُبٌ. وَبَيْتٌ؟",
"بيتان، بيوت. وولد؟": "بَيْتَانِ، بُيُوتٌ. وَوَلَدٌ؟",
"ولدان، أولاد. وبنت؟": "وَلَدَانِ، أَوْلَادٌ. وَبِنْتٌ؟",
"بنتان، بنات! صعب!": "بِنْتَانِ، بَنَاتٌ! صَعْبٌ!",
"ممتاز يا كين ويا يوسف. أنتما طالبان ممتازان. وهم؟": "مُمْتَازٌ يَا كِينْ وَيَا يُوسُفُ. أَنْتُمَا طَالِبَانِ مُمْتَازَانِ. وَهُمْ؟",
"هم طلّاب. وهنّ طالبات. وهما، طالبان أو طالبتان!": "هُمْ طُلَّابٌ. وَهُنَّ طَالِبَاتٌ. وَهُمَا، طَالِبَانِ أَوْ طَالِبَتَانِ!",
"مفرد": "مُفْرَدٌ",
"طالب مفرد.": "طَالِبٌ مُفْرَدٌ.",
"مثنّى": "مُثَنًّى",
"طالبان مثنّى.": "طَالِبَانِ مُثَنًّى.",
"جمع": "جَمْعٌ",
"طلّاب جمع.": "طُلَّابٌ جَمْعٌ.",
"هما": "هُمَا",
"هما طالبان.": "هُمَا طَالِبَانِ.",
"هم": "هُمْ",
"هم طلّاب.": "هُمْ طُلَّابٌ.",
"هنّ": "هُنَّ",
"هنّ طالبات.": "هُنَّ طَالِبَاتٌ.",
"أنتما": "أَنْتُمَا",
"أنتما طالبان ممتازان.": "أَنْتُمَا طَالِبَانِ مُمْتَازَانِ.",
"بيت، بيتان، بيوت": "بَيْتٌ، بَيْتَانِ، بُيُوتٌ",
"في الشارع بيوت كثيرة.": "فِي الشَّارِعِ بُيُوتٌ كَثِيرَةٌ.",
"ولد، ولدان، أولاد": "وَلَدٌ، وَلَدَانِ، أَوْلَادٌ",
"عندها ولدان.": "عِنْدَهَا وَلَدَانِ.",
"بنت، بنتان، بنات": "بِنْتٌ، بِنْتَانِ، بَنَاتٌ",
"عنده ثلاث بنات.": "عِنْدَهُ ثَلَاثُ بَنَاتٍ.",
"أربعة أقلام.": "أَرْبَعَةُ أَقْلَامٍ.",
"باب، بابان، أبواب": "بَابٌ، بَابَانِ، أَبْوَابٌ",
"للمعهد بابان.": "لِلْمَعْهَدِ بَابَانِ.",
"سيّارة، سيّارتان، سيّارات": "سَيَّارَةٌ، سَيَّارَتَانِ، سَيَّارَاتٌ",
"في الشارع سيّارات.": "فِي الشَّارِعِ سَيَّارَاتٌ.",
"دورك يا كين!": "دَوْرُكَ يَا كِينْ!",
"صعب، سهل": "صَعْبٌ، سَهْلٌ",
"صعب! ، لا، سهل.": "صَعْبٌ! لَا، سَهْلٌ.",
"ولد → ولدان → أولاد.": "وَلَدٌ، وَلَدَانِ، أَوْلَادٌ.",
"بنت → بنتان → بنات.": "بِنْتٌ، بِنْتَانِ، بَنَاتٌ.",
"هما طالبان، هم طلّاب، هنّ طالبات.": "هُمَا طَالِبَانِ، هُمْ طُلَّابٌ، هُنَّ طَالِبَاتٌ.",
"ولدان وبنتان": "وَلَدَانِ وَبِنْتَانِ",
"هم طلّاب وهنّ طالبات": "هُمْ طُلَّابٌ وَهُنَّ طَالِبَاتٌ",
"بيوت كثيرة": "بُيُوتٌ كَثِيرَةٌ"
}

'use client';
import {useEffect,useMemo,useState} from 'react';
import {useRouter} from 'next/navigation';
import {supabase} from '../../../lib/supabase/client';

const TARGET=4.2;
const mean=(a)=>a.length?a.reduce((x,y)=>x+y,0)/a.length:0;
const median=(a)=>{if(!a.length)return 0;const x=[...a].sort((a,b)=>a-b),m=Math.floor(x.length/2);return x.length%2?x[m]:(x[m-1]+x[m])/2};
function grade(score){return score>=4.2?{label:'ممتاز',color:'#07845e',bg:'#e8f8f0'}:score>=3.7?{label:'جيد',color:'#087a81',bg:'#e7f7f7'}:score>=3?{label:'يحتاج متابعة',color:'#b87009',bg:'#fff5df'}:{label:'أولوية عاجلة',color:'#be3030',bg:'#fff0f0'}}
function recommendation(axis){if(axis.mean>=4.2)return ['استدامة التميز','توثيق الممارسات الناجحة ومشاركتها مع فرق البرامج القادمة.','استدامة'];if(axis.mean>=3.7)return ['تحسين مستهدف','استثمار التغذية الراجعة لتحويل المحور من جيد إلى ممتاز خلال الدورة القادمة.','متوسطة'];if(axis.mean>=3)return ['خطة تحسين','تحليل الملاحظات النوعية وتحديد مسؤول وإجراء تصحيحي خلال 30 يوماً.','عالية'];return ['تدخل عاجل','إعداد خطة معالجة فورية ومراجعة أسبوعية للمؤشر حتى بلوغ المستهدف.','حرجة']}
export default function FinalAxisAnalysis(){const db=supabase(),router=useRouter();const[rows,setRows]=useState([]),[answers,setAnswers]=useState([]),[questions,setQuestions]=useState([]),[loading,setLoading]=useState(true),[selected,setSelected]=useState('');
useEffect(()=>{(async()=>{const {data:{session}}=await db.auth.getSession();if(!session){router.push('/login');return}const {data:e}=await db.from('evaluations').select('id,program_id,submitted_at,overall_rating').eq('kind','FINAL');const ids=(e||[]).map(x=>x.id);const {data:a}=ids.length?await db.from('evaluation_answers').select('evaluation_id,question_id,rating_value,text_value').in('evaluation_id',ids):{data:[]};const qids=[...new Set((a||[]).map(x=>x.question_id))];const {data:q}=qids.length?await db.from('questions').select('id,text_ar,section_ar').in('id',qids):{data:[]};setRows(e||[]);setAnswers(a||[]);setQuestions(q||[]);setLoading(false)})()},[]);
const axes=useMemo(()=>{const qm=Object.fromEntries(questions.map(q=>[q.id,q]));const groups={};answers.forEach(a=>{if(!a.rating_value)return;const q=qm[a.question_id];const name=q?.section_ar||'التقييم العام';(groups[name]??=[]).push(Number(a.rating_value))});return Object.entries(groups).map(([name,vals])=>{const dist=[1,2,3,4,5].map(n=>vals.filter(v=>Math.round(v)===n).length);const low=dist[0]+dist[1],high=dist[3]+dist[4];return {name,vals,mean:mean(vals),median:median(vals),count:vals.length,dist,lowPct:vals.length?low/vals.length*100:0,highPct:vals.length?high/vals.length*100:0}}).sort((a,b)=>a.mean-b.mean)},[answers,questions]);
useEffect(()=>{if(!selected&&axes[0])setSelected(axes[0].name)},[axes,selected]);const axis=axes.find(x=>x.name===selected)||axes[0];if(loading)return <main style={{padding:80,textAlign:'center'}}>جارٍ إعداد التحليل النهائي…</main>;if(!axis)return <main style={{padding:80,textAlign:'center'}}>لا توجد تقييمات نهائية كافية بعد.</main>;const g=grade(axis.mean),rec=recommendation(axis);return <main dir="rtl" style={{maxWidth:1180,margin:'auto',padding:'28px 18px',fontFamily:'Tahoma,Arial',color:'#19263d',background:'#f5f7fa',minHeight:'100vh'}}><header style={{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:22}}><div><h1 style={{margin:0,color:'#102c55'}}>التحليل التفصيلي لمحاور التقييم النهائي</h1><p style={{color:'#66758c'}}>برنامج تعليم اللغة العربية للناطقين بغيرها · تقييمات FINAL فقط</p></div><button onClick={()=>router.push('/reports')} style={{border:'1px solid #ccd7e5',background:'#fff',padding:'10px 15px',borderRadius:8,cursor:'pointer'}}>← التقرير الرئيسي</button></header><section style={{background:'#102c55',color:'#fff',borderRadius:16,padding:24,marginBottom:18}}><div style={{fontSize:13,color:'#f2cf89'}}>FINAL PROGRAM EVALUATION · AXIS DRILLDOWN</div><h2 style={{fontSize:30,margin:'10px 0'}}>قراءة قيادية تفصيلية لكل محور</h2><p style={{margin:0,color:'#d2e2ee'}}>عدد التقييمات النهائية: {rows.length} · المستهدف القياسي: {TARGET}/5</p></section><section style={{display:'flex',gap:8,flexWrap:'wrap',marginBottom:18}}>{axes.map(a=><button key={a.name} onClick={()=>setSelected(a.name)} style={{border:selected===a.name?'2px solid #00877d':'1px solid #d7e0eb',background:selected===a.name?'#e5f7f4':'#fff',padding:'10px 14px',borderRadius:20,cursor:'pointer',fontWeight:700}}>{a.name} · {a.mean.toFixed(2)}</button>)}</section><section style={{display:'grid',gridTemplateColumns:'repeat(4,1fr)',gap:12,marginBottom:18}}>{[['متوسط المحور',axis.mean.toFixed(2)+'/5'],['الوسيط',axis.median.toFixed(2)+'/5'],['رضا مرتفع',axis.highPct.toFixed(0)+'%'],['إجابات المحور',axis.count]].map(([l,v])=><article key={l} style={{background:'#fff',border:'1px solid #e1e7ef',borderRadius:12,padding:18}}><small style={{color:'#6b7890'}}>{l}</small><b style={{display:'block',fontSize:28,color:'#102c55',marginTop:8}}>{v}</b></article>)}</section><section style={{display:'grid',gridTemplateColumns:'1.4fr 1fr',gap:18}}><article style={{background:'#fff',padding:22,borderRadius:14,border:'1px solid #e1e7ef'}}><h2 style={{marginTop:0}}>توزيع درجات محور: {axis.name}</h2>{axis.dist.map((n,i)=>{const pct=axis.count?n/axis.count*100:0;return <div key={i} style={{display:'grid',gridTemplateColumns:'80px 1fr 60px',gap:12,alignItems:'center',margin:'13px 0'}}><span>{i+1} من 5</span><div style={{height:14,background:'#edf1f5',borderRadius:9,overflow:'hidden'}}><i style={{display:'block',height:'100%',width:pct+'%',background:i<2?'#d44b4b':i===2?'#d99a20':'#069276'}}/></div><b>{n} ({pct.toFixed(0)}%)</b></div>})}</article><article style={{background:g.bg,padding:22,borderRadius:14,border:'1px solid #dce5ed'}}><span style={{color:g.color,fontWeight:800}}>{g.label}</span><h2 style={{color:'#102c55'}}>القراءة التحليلية</h2><p style={{lineHeight:1.9}}>حقق محور <b>{axis.name}</b> متوسطاً قدره <b>{axis.mean.toFixed(2)} من 5</b>، بفجوة {(TARGET-axis.mean).toFixed(2)} عن المستهدف القياسي. بلغت نسبة التقييمات المرتفعة {axis.highPct.toFixed(0)}%، بينما بلغت نسبة التقييمات المنخفضة {axis.lowPct.toFixed(0)}%.</p><hr style={{border:0,borderTop:'1px solid #cbd9e2'}}/><h3>{rec[0]}</h3><p style={{lineHeight:1.8}}>{rec[1]}</p><p><b>الأولوية:</b> {rec[2]}</p></article></section><section style={{background:'#fff',border:'1px solid #e1e7ef',padding:22,borderRadius:14,marginTop:18}}><h2 style={{marginTop:0}}>خطة عمل المحور</h2><table style={{width:'100%',borderCollapse:'collapse'}}><thead><tr style={{background:'#102c55',color:'#fff'}}><th style={{padding:10,textAlign:'right'}}>المؤشر</th><th style={{padding:10,textAlign:'right'}}>الحالي</th><th style={{padding:10,textAlign:'right'}}>المستهدف</th><th style={{padding:10,textAlign:'right'}}>الإجراء</th><th style={{padding:10,textAlign:'right'}}>المسؤول</th></tr></thead><tbody><tr><td style={{padding:12}}>{axis.name}</td><td style={{padding:12}}>{axis.mean.toFixed(2)}/5</td><td style={{padding:12}}>{TARGET}/5</td><td style={{padding:12}}>{rec[1]}</td><td style={{padding:12}}>إدارة البرنامج / مالك المحور</td></tr></tbody></table></section></main>}
